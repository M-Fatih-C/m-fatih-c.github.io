---
import Layout from '../../../layouts/Layout.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import { getProjects } from '../../../lib/projects';
import { labels, languages, categories, statuses, type Lang } from '../../../lib/i18n';
export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang,
  t = labels[lang],
  projects = await getProjects(lang);
const techs = [...new Set(projects.flatMap((p) => p.data.technologies))].sort();
const years = [
  ...new Set(projects.map((p) => p.data.year).filter((y): y is number => y !== null)),
].sort((a, b) => b - a);
---

<Layout lang={lang} title={t.projects} section="projects">
  <div class="shell">
    <header class="page-head">
      <p class="eyebrow">
        {lang === 'tr' ? 'PROJE ARŞİVİ' : 'PROJECT INDEX'} / {lang.toUpperCase()}
      </p>
      <div class="page-hero-line">
        <h1>{lang === 'tr' ? 'Projeler' : 'Projects'}</h1>
        <div class="project-count">
          {projects.length}
          <small>{lang === 'tr' ? 'ÇALIŞMA' : 'WORKS'}</small>
        </div>
      </div>
      <p>
        {t.archiveText}{' '}
        {lang === 'tr'
          ? '22 depo ve bağlantılı bağımsız çalışmalar; her biri kendi kapsamı ve olgunluk düzeyiyle.'
          : '22 repositories and related independent work, each with its own scope and maturity.'}
      </p>
    </header>
    <form class="filters" role="search" aria-label={t.search}>
      <div class="filter-row">
        <label>
          {t.search}
          <input type="search" name="q" placeholder={t.searchHint} autocomplete="off" />
        </label>
        <label>
          {t.technology}
          <select name="technology">
            <option value="">{lang === 'tr' ? 'Tüm teknolojiler' : 'All technologies'}</option>
            {techs.map((tech) => (
              <option value={tech}>{tech}</option>
            ))}
          </select>
        </label>
        <label>
          {t.status}
          <select name="status">
            <option value="">{lang === 'tr' ? 'Tüm durumlar' : 'All statuses'}</option>
            {Object.entries(statuses).map(([id, label]) => (
              <option value={id}>{label[lang]}</option>
            ))}
          </select>
        </label>
        <label>
          {t.year}
          <select name="year">
            <option value="">{t.anyYear}</option>
            {years.map((year) => (
              <option value={year}>{year}</option>
            ))}
            <option value="unknown">{t.unknownYear}</option>
          </select>
        </label>
      </div>
      <div class="category-tabs" role="group" aria-label={t.category}>
        <button type="button" data-category="" aria-pressed="true">
          {t.all}
        </button>
        {Object.entries(categories).map(([id, label]) => (
          <button type="button" data-category={id} aria-pressed="false">
            {label[lang]}
          </button>
        ))}
      </div>
    </form>
    <div class="filter-meta">
      <p aria-live="polite" aria-atomic="true">
        <span data-result-count>{projects.length}</span> {t.resultsCount}
      </p>
      <button type="button" class="reset-filters">
        {t.reset}
      </button>
    </div>
    <h2 class="sr-only">{t.projects}</h2>
    <div class="featured-grid" style="padding-bottom:80px">
      {projects.map((project, index) => (
        <ProjectCard project={project} lang={lang} index={index} />
      ))}
    </div>
    <p class="no-results" hidden>
      {t.noResults}
    </p>
  </div>
  <script>
    const form = document.querySelector<HTMLFormElement>('.filters');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-project-card]'));
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-category]'));
    let category = '';
    const apply = () => {
      if (!form) return;
      const data = new FormData(form),
        query = String(data.get('q') ?? '')
          .toLocaleLowerCase(document.documentElement.lang)
          .trim(),
        tech = String(data.get('technology') ?? ''),
        status = String(data.get('status') ?? ''),
        year = String(data.get('year') ?? '');
      let count = 0;
      for (const card of cards) {
        const show =
          (!query || (card.dataset.search ?? '').includes(query)) &&
          (!category || (card.dataset.categories ?? '').split(' ').includes(category)) &&
          (!tech || JSON.parse(card.dataset.technologies ?? '[]').includes(tech)) &&
          (!status || card.dataset.status === status) &&
          (!year || card.dataset.year === year);
        card.hidden = !show;
        if (show) count++;
      }
      const total = document.querySelector('[data-result-count]');
      if (total) total.textContent = String(count);
      document.querySelector<HTMLElement>('.no-results')?.toggleAttribute('hidden', count > 0);
      const params = new URLSearchParams();
      if (query) params.set('q', String(data.get('q')));
      if (category) params.set('category', category);
      if (tech) params.set('technology', tech);
      if (status) params.set('status', status);
      if (year) params.set('year', year);
      const suffix = params.size ? '?' + params.toString() : '';
      history.replaceState(null, '', location.pathname + suffix);
      const switcher = document.querySelector<HTMLAnchorElement>('[data-lang-switch]');
      if (switcher) switcher.search = suffix;
    };
    const initial = new URLSearchParams(location.search);
    for (const key of ['q', 'technology', 'status', 'year']) {
      const field = form?.elements.namedItem(key) as HTMLInputElement | HTMLSelectElement | null;
      if (field) field.value = initial.get(key) ?? '';
    }
    category = initial.get('category') ?? '';
    if (!buttons.some((button) => button.dataset.category === category)) category = '';
    const setCategory = () =>
      buttons.forEach((button) =>
        button.setAttribute('aria-pressed', String(button.dataset.category === category)),
      );
    setCategory();
    form?.addEventListener('submit', (event) => event.preventDefault());
    form?.addEventListener('input', apply);
    form?.addEventListener('change', apply);
    buttons.forEach((button) =>
      button.addEventListener('click', () => {
        category = button.dataset.category ?? '';
        setCategory();
        apply();
      }),
    );
    document.querySelector('.reset-filters')?.addEventListener('click', () => {
      form?.reset();
      category = '';
      setCategory();
      apply();
    });
    apply();
  </script>
</Layout>
