---
import { ArrowUpRight, Download, GraduationCap } from '@lucide/astro';
import Layout from '../../layouts/Layout.astro';
import Timeline from '../../components/Timeline.astro';
import { education, certifications } from '../../data/profile';
import { labels, path, languages, type Lang } from '../../lib/i18n';
export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang,
  t = labels[lang],
  tr = lang === 'tr';
const skills = [
  {
    title: tr ? 'Diller' : 'Languages',
    tech: ['Python', 'TypeScript', 'Swift', 'C#', 'Dart', 'Kotlin'],
    ids: [
      ['minigpt-m4', 'MiniGPT-M4'],
      ['macpilot', 'MacPilot'],
      ['risemate-ios', 'RiseMate'],
    ],
  },
  {
    title: 'Backend & APIs',
    tech: ['FastAPI', 'SQLAlchemy', 'ASP.NET Core', 'REST', 'WebSocket'],
    ids: [
      ['osint-framework', 'OSINT Framework'],
      ['finansim', 'Finansım'],
    ],
  },
  {
    title: 'AI / ML',
    tech: ['PyTorch', 'MLX', 'scikit-learn', 'Transformers', 'FAISS'],
    ids: [
      ['minigpt-m4', 'MiniGPT-M4'],
      ['tenderai', 'TenderAI'],
      ['sleep-apnea-risk-model', 'OSAS'],
    ],
  },
  {
    title: tr ? 'Veri & Veritabanları' : 'Data & Databases',
    tech: ['pandas', 'NumPy', 'SQLite', 'SQL Server', 'PostgreSQL'],
    ids: [
      ['ing-datathon', 'ING Datathon'],
      ['finansim', 'Finansım'],
    ],
  },
  {
    title: tr ? 'Mobil & Masaüstü' : 'Mobile & Desktop',
    tech: ['SwiftUI', 'Flutter', 'PyQt5', 'PySide6'],
    ids: [
      ['risemate-ios', 'RiseMate'],
      ['tanita-report-extractor', 'Tanita'],
      ['minicpuz', 'MiniCPUZ'],
    ],
  },
  {
    title: tr ? 'Altyapı & Entegrasyon' : 'Infrastructure & Integration',
    tech: ['GitHub Actions', 'Docker', 'Firebase', 'Windows Server', 'Active Directory', 'Hyper-V'],
    ids: [
      ['enterprise-workflow-integration', tr ? 'Kurumsal iş akışları' : 'Enterprise workflows'],
      ['jarvis-core', 'Jarvis Core'],
    ],
  },
];
---

<Layout lang={lang} title={t.about} section="about">
  <div class="shell">
    <header class="page-head">
      <p class="eyebrow">ABOUT / {tr ? 'YAKLAŞIMIM' : 'MY APPROACH'}</p>
      <h1>{tr ? 'Hakkımda' : 'About me'}</h1>
    </header>
    <div class="about-intro">
      <div>
        <p>
          {tr
            ? 'Ben Muhammet Fatih Çetintaş. Yazılım geliştirme, uygulamalı yapay zekâ, veri analitiği ve sistem entegrasyonunun kesişiminde çalışıyorum. Bir problemin yalnızca arayüzünü değil, arkasındaki veriyi, süreci ve teknik sınırları da anlamayı önemsiyorum.'
            : 'I am Muhammet Fatih Çetintaş. I work at the intersection of software development, applied AI, data analytics and systems integration. I care about understanding the data, process and technical boundaries behind a problem, as well as its interface.'}
        </p>
        <p>
          {tr
            ? 'Çalışmalarım yerel dil modeli deneylerinden belge işlemeye, finansal kayıt sistemlerinden sağlık araştırma araçlarına uzanıyor. Kurumsal sistemlerle çalışma deneyimim, teknik bir çözümün gerçek kullanım koşullarına nasıl uyduğunu sorgulamamı sağlıyor.'
            : 'My work ranges from local language-model experiments and document processing to financial records and healthcare research tools. Experience with enterprise systems shapes the way I examine how a technical solution fits its real operating context.'}
        </p>
        <p>
          {tr
            ? 'Deney, prototip ve doğrulanmış sonuç arasında ayrım yapıyorum. Mimariyi açıklamak, veriyi korumak ve çalıştırılan testlerin sınırını dürüstçe aktarmak; geliştirme sürecimin parçası.'
            : 'I distinguish experiments, prototypes and validated outcomes. Explaining architecture, protecting data and describing the limits of testing are part of how I build.'}
        </p>
        <div class="hero-actions">
          <a class="button" href={path(lang, 'cv')}>
            {t.cv}
            <ArrowUpRight size={17} />
          </a>
          <a class="button secondary" href={`/cv/muhammet-fatih-cetintas-2026.pdf`} download>
            <Download size={16} />
            {t.cvDownload}
          </a>
        </div>
      </div>
      <aside class="identity-panel">
        <div class="monogram">MFÇ.</div>
        <h2>{t.title}</h2>
        <p>
          {tr
            ? 'Python ve C#/.NET · Veri analitiği · Sistem entegrasyonu'
            : 'Python and C#/.NET · Data analytics · Systems integration'}
        </p>
        <dl>
          <dt>{tr ? 'Odak' : 'Focus'}</dt>
          <dd>Software · AI · Data · Integration</dd>
          <dt>{tr ? 'Çalışma yaklaşımı' : 'Working approach'}</dt>
          <dd>
            {tr
              ? 'Problem → Modelleme → Uygulama → Doğrulama'
              : 'Problem → Modeling → Implementation → Validation'}
          </dd>
          <dt>{tr ? 'İletişim' : 'Contact'}</dt>
          <dd>
            <a href="mailto:muhammedfatihcetintas54@gmail.com">muhammedfatihcetintas54@gmail.com</a>
          </dd>
        </dl>
        <p class="profile-languages">
          {tr
            ? 'Türkçe: Ana dil · İngilizce: Orta düzey, teknik okuma ve yazma'
            : 'Turkish: Native · English: Intermediate, technical reading and writing'}
        </p>
      </aside>
    </div>
    <section class="section split-section" style="padding-top:0">
      <div>
        <p class="eyebrow">01 / {tr ? 'PROFESYONEL DENEYİM' : 'PROFESSIONAL EXPERIENCE'}</p>
        <h2>{tr ? 'İş deneyimi' : 'Work experience'}</h2>
        <p>
          {tr
            ? 'Yazılım, altyapı, uygulama desteği ve entegrasyon deneyimleri; problemleri sistem düzeyinde ele almamı destekliyor.'
            : 'Software, infrastructure, application support and integration experience inform a systems-level approach to problem solving.'}
        </p>
      </div>
      <Timeline lang={lang} />
    </section>
    <section class="section" style="padding-top:0">
      <div class="section-heading">
        <div>
          <p class="eyebrow">02 / {tr ? 'EĞİTİM' : 'EDUCATION'}</p>
          <h2>{tr ? 'Eğitim' : 'Education'}</h2>
        </div>
        <GraduationCap size={38} stroke-width={1.2} />
      </div>
      <div class="education-grid">
        {education[lang].map((item) => (
          <article class="education-card">
            <p class="degree">{item.degree}</p>
            <h3>{item.program}</h3>
            <p>{item.school}</p>
            <small>{item.status}</small>
          </article>
        ))}
      </div>
    </section>
    <section class="section" style="padding-top:0">
      <div class="section-heading">
        <div>
          <p class="eyebrow">03 / {tr ? 'TEKNİK ARAÇLAR' : 'TECHNICAL TOOLKIT'}</p>
          <h2>{tr ? 'Teknik yetkinlikler' : 'Technical skills'}</h2>
        </div>
      </div>
      <div class="skills-grid">
        {skills.map((skill) => (
          <article class="skill-group">
            <h3>{skill.title}</h3>
            <ul class="tags">
              {skill.tech.map((tech) => (
                <li>{tech}</li>
              ))}
            </ul>
            <p>
              {tr ? 'İlgili çalışmalar: ' : 'Related work: '}
              {skill.ids.map(([id, title], index) => (
                <>
                  {index > 0 ? ' · ' : ''}
                  <a href={path(lang, `projects/${id}`)}>{title}</a>
                </>
              ))}
            </p>
          </article>
        ))}
      </div>
    </section>
    <section class="research-text">
      <h2>{tr ? 'Araştırma ve akademik katkı' : 'Research and academic contribution'}</h2>
      <p>
        {tr
          ? 'Sakarya Üniversitesi Tıp Fakültesi ile ilişkili uyku apnesi araştırmasında yaklaşık 400 Tanita raporunun veri çıkarma ve temizleme süreçlerini yürüttüm; 395 hastayı kapsayan yapılandırılmış analiz veri setinin hazırlanmasına katkıda bulundum. Antropometrik ölçümler, klinik değişkenler, AHI/OSAS sınıfları ve anket sonuçlarıyla veri işleme ve model değerlendirme çalışmaları yaptım. EEG/ALS tarafında ise evet/hayır niyet sınıflandırmasına yönelik sinyal işleme ve makine öğrenmesi prototipleri üzerinde çalıştım. Bu çalışmalar araştırma kapsamındadır.'
          : 'In sleep-apnea research associated with Sakarya University Faculty of Medicine, I extracted and cleaned data from approximately 400 Tanita reports and contributed to a structured analysis dataset covering 395 patients. I worked with anthropometric measurements, clinical variables, AHI/OSAS classes and questionnaire results for data processing and model evaluation. My EEG/ALS work involved signal processing and machine-learning prototypes for yes/no intent classification. These remain research activities.'}
      </p>
      <a class="text-link" href={path(lang, 'research')}>
        {t.research}
        <ArrowUpRight size={15} />
      </a>
    </section>
    <section class="research-text" style="margin-bottom:80px">
      <h2>
        {tr ? 'Sertifikalar ve mesleki gelişim' : 'Certifications and professional development'}
      </h2>
      <p>
        {tr
          ? 'Sertifika kayıtlarımı ve mesleki gelişim geçmişimi LinkedIn profilimde paylaşıyorum.'
          : 'My certification records and professional development history are available on my LinkedIn profile.'}
      </p>
      <div class="certification-grid">
        {certifications[lang].map((item) => (
          <article class="certification-card">
            <p class="eyebrow">
              {item.issuer}
              {item.year ? ` / ${item.year}` : ''}
            </p>
            <h3>{item.title}</h3>
          </article>
        ))}
      </div>
      <a
        class="text-link"
        href="https://tr.linkedin.com/in/muhammet-fatih-%C3%A7etintas/details/certifications/"
        target="_blank"
        rel="noopener noreferrer"
      >
        {tr ? 'LinkedIn’de sertifikalar' : 'Certifications on LinkedIn'}
        <ArrowUpRight size={15} />
      </a>
    </section>
  </div>
</Layout>
