---
import {
  ArrowUpRight,
  Sun,
  Moon,
  Menu,
  ArrowUp,
  CodeXml as Github,
  ContactRound as Linkedin,
  Mail,
} from '@lucide/astro';
import { labels, path, type Lang } from '../lib/i18n';
import '../styles/global.css';
import { Image } from 'astro:assets';
import brandImage from '../assets/mfc-logo.jpg';
import '@fontsource-variable/manrope';
import '@fontsource-variable/space-grotesk';
interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  section?: string;
  noindex?: boolean;
}
const { lang, title, description, section = '', noindex = false } = Astro.props;
const t = labels[lang],
  other = lang === 'tr' ? 'en' : 'tr';
const current = Astro.url.pathname;
const localizedCurrent = /^\/(tr|en)\//.test(current) ? current : path(lang, '404');
const alternate = localizedCurrent.replace(/^\/(tr|en)(?=\/|$)/, `/${other}`);
const pageTitle = title
  ? `${title} — Muhammet Fatih Çetintaş`
  : `Muhammet Fatih Çetintaş — ${t.title}`;
const desc =
  description ||
  (lang === 'tr'
    ? 'Yazılım geliştirme, uygulamalı yapay zekâ, veri bilimi ve sistem entegrasyonu. Muhammet Fatih Çetintaş’ın proje ve araştırma portföyü.'
    : 'Software development, applied AI, data science and systems integration. The project and research portfolio of Muhammet Fatih Çetintaş.');
const canonical = new URL(localizedCurrent, Astro.site);
const social = new URL(`/social/${lang}.png`, Astro.site);
const nav = [
  ['projects', t.projects],
  ['about', t.about],
  ['research', t.research],
];
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0b1020" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      hreflang="tr"
      href={new URL(localizedCurrent.replace(/^\/(tr|en)/, '/tr'), Astro.site)}
    />
    <link
      rel="alternate"
      hreflang="en"
      href={new URL(localizedCurrent.replace(/^\/(tr|en)/, '/en'), Astro.site)}
    />
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localizedCurrent.replace(/^\/(tr|en)/, '/tr'), Astro.site)}
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={social} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'tr' ? 'tr_TR' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      try {
        const theme = localStorage.getItem('mfc-theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t.skip}
    </a>
    <header class="site-header">
      <div class="shell nav-inner">
        <a class="brand" href={path(lang)} aria-label={`MFÇ — Muhammet Fatih Çetintaş — ${t.home}`}>
          <Image
            class="nav-brand-image"
            src={brandImage}
            width={108}
            height={60}
            alt="MFÇ"
            format="webp"
            quality={85}
          />
        </a>
        <nav id="main-nav" aria-label={lang === 'tr' ? 'Ana menü' : 'Main navigation'}>
          {nav.map(([route, label]) => (
            <a href={path(lang, route)} aria-current={section === route ? 'page' : undefined}>
              {label}
            </a>
          ))}
          <a class="nav-contact" href={path(lang, 'contact')}>
            {t.contact}
            <ArrowUpRight size={15} />
          </a>
        </nav>
        <div class="nav-controls">
          <a
            class="lang-switch"
            data-lang-switch
            href={alternate}
            lang={other}
            hreflang={other}
            aria-label={other === 'en' ? 'TR / EN — Switch to English' : 'TR / EN — Türkçeye geç'}
          >
            <span class:list={{ 'is-current': lang === 'tr' }}>TR</span>
            <span class="divider">/</span>
            <span class:list={{ 'is-current': lang === 'en' }}>EN</span>
          </a>
          <button class="icon-button theme-toggle" aria-label={t.theme} title={t.theme}>
            <Sun class="sun" size={18} />
            <Moon class="moon" size={18} />
          </button>
          <button
            class="icon-button menu-toggle"
            aria-label={t.menu}
            aria-controls="main-nav"
            aria-expanded="false"
          >
            <Menu size={22} />
          </button>
        </div>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell">
        <div class="footer-top">
          <a class="brand" href={path(lang)}>
            MFÇ<span>.</span>
          </a>
          <p>{t.footer}</p>
          <div class="social-links">
            <a
              href="https://github.com/M-Fatih-C"
              aria-label="GitHub"
              target="_blank"
              rel="noopener noreferrer"
            >
              <Github size={20} />
            </a>
            <a
              href="https://tr.linkedin.com/in/muhammet-fatih-%C3%A7etintas"
              aria-label="LinkedIn"
              target="_blank"
              rel="noopener noreferrer"
            >
              <Linkedin size={20} />
            </a>
            <a href="mailto:muhammedfatihcetintas54@gmail.com" aria-label={t.email}>
              <Mail size={20} />
            </a>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} Muhammet Fatih Çetintaş</span>
          <span>{t.made}</span>
          <a href="#main">
            {t.top}
            <ArrowUp size={13} />
          </a>
        </div>
      </div>
    </footer>
    <script>
      import '../scripts/motion';
      const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
      toggle?.addEventListener('click', () => {
        const theme = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
        document.documentElement.dataset.theme = theme;
        try {
          localStorage.setItem('mfc-theme', theme);
        } catch {}
      });
      const menu = document.querySelector<HTMLButtonElement>('.menu-toggle');
      menu?.addEventListener('click', () => {
        const open = menu.getAttribute('aria-expanded') !== 'true';
        menu.setAttribute('aria-expanded', String(open));
        document.querySelector('#main-nav')?.classList.toggle('open', open);
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          menu?.setAttribute('aria-expanded', 'false');
          document.querySelector('#main-nav')?.classList.remove('open');
        }
      });
      document.querySelector('[data-lang-switch]')?.addEventListener('click', (event) => {
        const target = event.currentTarget as HTMLAnchorElement;
        const locale = new URL(target.href).pathname.split('/')[1];
        try {
          localStorage.setItem('mfc-lang', locale ?? 'tr');
        } catch {}
      });
    </script>
  </body>
</html>
