---
interface Props {
  kind?: string;
  seed?: string;
  large?: boolean;
}
const { kind = 'software', seed = 'project', large = false } = Astro.props;
const accent =
  {
    ai: '#a99aff',
    ml: '#a99aff',
    research: '#ffb078',
    data: '#60daca',
    mobile: '#7cb5ff',
    software: '#7cb5ff',
    vision: '#ffb078',
    enterprise: '#60daca',
    archive: '#c3a4ef',
    competitions: '#ffb078',
  }[kind] || '#7cb5ff';
const id = `art-${seed}`;
---

<div
  class:list={['project-art', `art-${kind}`, { large }]}
  style={`--art-color:${accent}`}
  aria-hidden="true"
>
  <svg viewBox="0 0 640 300" fill="none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <pattern id={`${id}-grid`} width="32" height="32" patternUnits="userSpaceOnUse">
        <path d="M32 0H0V32" stroke="currentColor" stroke-opacity=".11" />
      </pattern>
      <radialGradient id={`${id}-glow`}>
        <stop stop-color={accent} stop-opacity=".2" />
        <stop offset="1" stop-color={accent} stop-opacity="0" />
      </radialGradient>
    </defs>
    <rect width="640" height="300" fill={`url(#${id}-grid)`} />
    <ellipse cx="340" cy="150" rx="250" ry="150" fill={`url(#${id}-glow)`} />
    {kind === 'ai' || kind === 'ml' || kind === 'vision' ? (
      <g stroke={accent}>
        {[76, 150, 224].map((y) =>
          [60, 120, 180, 240].map((y2) => <path d={`M190 ${y}L320 ${y2}`} opacity=".27" />),
        )}
        {[60, 120, 180, 240].map((y) =>
          [100, 200].map((y2) => <path d={`M320 ${y}L455 ${y2}`} opacity=".27" />),
        )}
        {[76, 150, 224].map((y) => (
          <circle cx="190" cy={y} r="12" fill="var(--art-base)" stroke-width="2" />
        ))}
        {[60, 120, 180, 240].map((y) => (
          <circle cx="320" cy={y} r="15" fill="var(--art-base)" stroke-width="2" />
        ))}
        {[100, 200].map((y) => (
          <circle cx="455" cy={y} r="18" fill="var(--art-base)" stroke-width="2" />
        ))}
        <path d="M473 150H520" stroke-dasharray="4 6" opacity=".5" />
      </g>
    ) : kind === 'data' || kind === 'research' ? (
      <g stroke={accent}>
        <path d="M140 65V235H510" opacity=".3" />
        <path
          d="M155 205C190 205 190 150 235 165S290 80 330 115S385 45 435 80S465 60 500 48"
          stroke-width="3"
        />
        {[0, 1, 2, 3, 4, 5, 6, 7].map((i) => (
          <rect
            x={164 + i * 43}
            y={210 - i * 17}
            width="22"
            height={25 + i * 17}
            rx="4"
            fill={accent}
            fill-opacity={0.1 + i * 0.035}
            stroke-opacity=".3"
          />
        ))}
      </g>
    ) : kind === 'mobile' ? (
      <g stroke={accent}>
        <rect
          x="140"
          y="65"
          width="290"
          height="165"
          rx="13"
          fill="var(--art-base)"
          stroke-opacity=".6"
        />
        <path d="M270 230V247M218 247H327" opacity=".6" />
        <rect
          x="380"
          y="95"
          width="90"
          height="155"
          rx="16"
          fill="var(--art-base)"
          stroke-width="2"
        />
        <path d="M407 108H442M414 236H435" opacity=".6" />
        <path d="M175 114H285M175 137H330M175 160H250" stroke-width="5" opacity=".4" />
        <circle cx="425" cy="172" r="17" fill={accent} fill-opacity=".2" />
      </g>
    ) : (
      <g stroke={accent}>
        <rect
          x="125"
          y="67"
          width="220"
          height="162"
          rx="14"
          fill="var(--art-base)"
          stroke-opacity=".6"
        />
        <path d="M125 103H345" opacity=".5" />
        {[148, 163, 178].map((x) => (
          <circle cx={x} cy="85" r="3" fill={accent} opacity=".6" />
        ))}
        <path
          d="M157 136L142 150L157 164M203 136L218 150L203 164M185 130L174 171"
          stroke-width="3"
        />
        <path d="M147 197H269" opacity=".3" />
        <rect
          x="386"
          y="110"
          width="100"
          height="85"
          rx="12"
          fill="var(--art-base)"
          stroke-opacity=".7"
        />
        <path d="M345 150H386" stroke-dasharray="5 5" />
        <rect x="408" y="131" width="56" height="10" rx="5" fill={accent} fill-opacity=".3" />
        <path d="M408 160H464M408 175H440" opacity=".5" />
      </g>
    )}
    <path d="M30 35H45M30 35V50M610 265H595M610 265V250" stroke={accent} opacity=".6" />
  </svg>
</div>
