{
  "name": "m-fatih-c-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "check:content": "node scripts/check-content.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:privacy": "node scripts/check-privacy.mjs",
    "build": "npm run check:content && astro build && npm run check:links && npm run check:privacy",
    "preview": "astro preview --host 127.0.0.1",
    "lint": "eslint src scripts && prettier --check .",
    "format": "prettier --write .",
    "qa": "npm run check && npm run lint && npm run build"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@lucide/astro": "1.70.0",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.7",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "lighthouse": "13.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "yaml": "2.9.1"
  },
  "overrides": {
    "minimatch": "11.0.5"
  }
}
